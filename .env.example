# Brevo Free supports up to 300 transactional emails per day.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# A verified sender configured in Brevo (never put the API key in the client).
EMAIL_FROM=
EMAIL_FROM_NAME=Kanban
# The public frontend origin used in verification and reset links.
APP_URL=http://localhost
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# One trusted nginx proxy in docker-compose.yml; production uses two proxies.
TRUST_PROXY_HOPS=1
